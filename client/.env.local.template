# ============================================
# FIREBASE CONFIGURATION
# ============================================
# Get these values from Firebase Console:
# https://console.firebase.google.com > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ============================================
# POSTHOG ANALYTICS (Optional)
# ============================================
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# DODO PAYMENTS CONFIGURATION
# ============================================
# Get these values from Dodo Payments Dashboard:
# https://app.dodopayments.com > Developer > API Keys / Webhooks
DODO_PAYMENTS_API_KEY=your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=your_dodo_webhook_secret_here
DODO_PAYMENTS_RETURN_URL=https://yourdomain.com/checkout/success
DODO_PAYMENTS_ENVIRONMENT=test_mode
NEXT_PUBLIC_DODO_PAYMENTS_MODE=test
NEXT_PUBLIC_DODO_PRODUCT_CORE=pdt_your_core_product_id
NEXT_PUBLIC_DODO_PRODUCT_PRIME=pdt_your_prime_product_id
NEXT_PUBLIC_DODO_PRODUCT_APEX=pdt_your_apex_product_id
NEXT_PUBLIC_APP_URL=https://yourdomain.com

